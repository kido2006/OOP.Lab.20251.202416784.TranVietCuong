<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="Options">
                  <items>
                        <Menu mnemonicParsing="false" text="Update Store">
                          <items>
                            <MenuItem mnemonicParsing="false" onAction="#handleAddBook" text="Add Book" />
                              <MenuItem mnemonicParsing="false" onAction="#handleAddCD" text="Add CD" />
                              <MenuItem mnemonicParsing="false" onAction="#handleAddDVD" text="Add DVD" />
                          </items>
                        </Menu>
                    <MenuItem mnemonicParsing="false" onAction="#handleViewCart" text="View Cart" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 20 10 20;">
               <children>
                  <Label styleClass="app-title" text="AIMS STORE" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleViewCart" styleClass="btn-view-cart" text="View Cart" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <FlowPane fx:id="flowPane" hgap="20.0" prefWrapLength="820.0" styleClass="store-pane" vgap="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" top="20.0" />
         </padding>
      </FlowPane>
   </center>
</BorderPane>